    "#run monte carlo\n",
    "\n",
    "n = 300_000\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "for uid in range(n):\n",
    "    game.run(uid)\n",
    "\n",
    "    if uid % 1000 == 0:\n",
    "        print(f\"Simulated games: {uid:_} / {n:_}\")\n",
    "        \n",
    "game_history_df = pd.DataFrame(game.game_master_list)\n",
    "game_history_df.to_parquet(game.folder_path + \"/History.parquet\")\n",
    "\n",
    "\n"
   ]
